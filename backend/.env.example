# NISAR Flood & Wetland Monitor - Environment Configuration

# Data Mode: MOCK, LOCAL, API, or CLOUD
DATA_MODE=MOCK
DATA_DIR=./data

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=False

# Earthdata Credentials (for API mode)
ASF_USERNAME=your_earthdata_username
ASF_PASSWORD=your_earthdata_password

# Processing Parameters
MAX_SUBSET_PIXELS=15000000

# Flood Detection Thresholds (dB)
DEFAULT_FLOOD_CHANGE_THRESHOLD=-2.0
DEFAULT_LOW_BACKSCATTER_THRESHOLD=-15.0

# Logging
LOG_LEVEL=INFO
LOG_FILE=./logs/app.log
